{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZERO_ONE",
  "version": "1.0.0",
  "identifier": "com.katbinaris.zeroone",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm vite:dev",
    "beforeBuildCommand": "pnpm vite:build"
  },
  "app": {
    "windows": [
      {
        "title": "ZeroOne",
        "width": 1100,
        "height": 740,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' ipc: asset:; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https:; font-src 'self' asset: data:; connect-src ipc: asset: http://localhost:5173 ws://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
